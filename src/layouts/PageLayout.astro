---
// 모든 쪽의 틀(2026-11-20 새 디자인) — 머리 · 바닥 · 메타. 홈은 home 으로 머리 이름을 첫 화면 뒤로 미룬다.
// 방침 · 지원 쪽(src/pages/notmine/** · repyep/**)도 이 틀을 쓴다 — 그 파일들은 손대지 않고 틀만 바꾼다.
import "@styles/site.css"
import { SITE } from "@consts"

type Props = {
  title: string
  description: string
  lang?: string
  home?: boolean
}

const { title, description, lang = "ko", home = false } = Astro.props
const fullTitle = home ? SITE.TITLE : `${title} | ${SITE.TITLE}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const image = new URL("/og.png", Astro.site)
const path = Astro.url.pathname
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/WantedSansVariable-KR.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class:list={["bar", { "is-home": home }]} data-bar>
      <a href="/" class="bar-mark" aria-label="sehahub">sehahub</a>
      <a href="/#products" class="bar-link">Products</a>
      <a href="/projects/" class="bar-link" aria-current={path.startsWith("/projects/") ? "page" : undefined}>Projects</a>
      <a href="mailto:contact@sehahub.info" class="bar-mail" aria-label="contact@sehahub.info">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11H3z M3 6.5l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span class="foot-mark">sehahub</span>
      <a href="mailto:contact@sehahub.info">contact@sehahub.info</a>
    </footer>

    <script>
      // 머리 — 홈은 첫 화면을 60% 지나면, 다른 쪽은 조금만 내려도 바탕을 깐다
      const bar = document.querySelector<HTMLElement>("[data-bar]")
      const home = bar?.classList.contains("is-home")
      const onScroll = () => bar?.classList.toggle("is-past", window.scrollY > (home ? window.innerHeight * 0.6 : 8))
      window.addEventListener("scroll", onScroll, { passive: true })
      onScroll()
    </script>
  </body>
</html>
