---
// 모든 쪽의 틀(2026-11-20 새 디자인) — 머리 · 바닥 · 메타. 홈은 home 으로 머리 이름을 첫 화면 뒤로 미룬다.
// 방침 · 지원 쪽(src/pages/notmine/** · repyep/**)도 이 틀을 쓴다 — 그 파일들은 손대지 않고 틀만 바꾼다.
import "@styles/site.css"
import { SITE } from "@consts"
import { LANGS, LANG_NAMES, localePath, type Alternates, type Lang } from "@i18n"

type Props = {
  title: string
  description: string
  lang?: string
  home?: boolean
  // 같은 쪽의 다른 언어 주소(언어 → 경로) — 그룹 쪽만 준다(2026-11-26). 없으면 언어 버튼 · hreflang 없이 예전과 같다(팀 방침 · 지원 쪽)
  alternates?: Alternates
}

const { title, description, lang = "ko", home = false, alternates } = Astro.props
const fullTitle = home ? SITE.TITLE : `${title} | ${SITE.TITLE}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const image = new URL("/og.png", Astro.site)
const path = Astro.url.pathname

// 언어 — 다른 언어 판이 있는 쪽만 버튼 · hreflang 을 단다. 머리 링크도 그 언어 쪽으로(없는 쪽은 예전처럼 한국어 쪽으로)
const langs = alternates ? LANGS.filter((l) => alternates[l]) : []
const multi = langs.length > 1
const navLang = (multi ? lang : "ko") as Lang

// 홈에만 — 검색 · AI 가 「sehahub = 이 사이트를 낸 곳」을 정해진 형식으로 읽게(11/24 SEO · 쪽에 보이는 사실만: 이름 · 주소 · 머리의 연락 메일)
// 앱 정보(이름 · iPhone · 앱스토어 · 가격)는 각 제품 쪽에서 팀이 넣는다 — 홈에 앱을 넣으면 가격 · 평점이 없어 Search Console 이 오류로 센다
const homeLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", Astro.site).href,
      name: SITE.TITLE,
      url: new URL("/", Astro.site).href,
      email: "contact@sehahub.info",
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: SITE.TITLE,
      url: new URL("/", Astro.site).href,
      // 홈이 한국어 · 영어 · 일본어 셋이 됐다(2026-11-26)
      inLanguage: ["ko", "en", "ja"],
      publisher: { "@id": new URL("/#organization", Astro.site).href },
    },
  ],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      // 어두운 판 — 그리기 전에 정한다(깜빡임 없게). 해/달 버튼으로 고른 것이 있으면 그것, 없으면 기기 설정
      (() => {
        let t = null
        try { t = localStorage.getItem("theme") } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        document.documentElement.dataset.theme = t
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/WantedSansVariable-KR.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    {multi && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates![l]!, Astro.site)} />)}
    {multi && alternates!.ko && <link rel="alternate" hreflang="x-default" href={new URL(alternates!.ko, Astro.site)} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {home && <script type="application/ld+json" set:html={JSON.stringify(homeLd)} />}
  </head>
  <body>
    <header class:list={["bar", { "is-home": home, "has-lang": multi }]} data-bar>
      <a href={localePath(navLang, "/")} class="bar-mark" aria-label="sehahub">sehahub</a>
      <a href={`${localePath(navLang, "/")}#products`} class="bar-link">Products</a>
      <a href={localePath(navLang, "/projects/")} class="bar-link" aria-current={path.startsWith(localePath(navLang, "/projects/")) ? "page" : undefined}>Projects</a>{multi && (
        // 언어 — 지구 그림 버튼 · 누르면 짧은 차림(그 언어로 쓴 이름). 스크립트 없이도 열리고 닫힌다(details)
        // 바로 앞 </a> 에 붙여 쓴다 — 줄을 바꾸면 버튼이 없는 쪽(팀 방침 · 지원)에도 빈칸 한 글자가 더 생긴다
        <details class="bar-lang" data-lang-menu>
          <summary aria-label="Language">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3.4 12h17.2M12 3.4c2.3 2.4 3.5 5.3 3.5 8.6s-1.2 6.2-3.5 8.6c-2.3-2.4-3.5-5.3-3.5-8.6S9.7 5.8 12 3.4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          </summary>
          <ul class="bar-lang-menu">
            {langs.map((l) => (
              <li>
                <a href={alternates![l]} lang={l} hreflang={l} aria-current={l === lang ? "page" : undefined}>
                  {LANG_NAMES[l]}
                  {l === lang && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
      <button type="button" class="bar-theme" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M5.5 18.5l1.4-1.4M17.1 6.9l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <a href="mailto:contact@sehahub.info" class="bar-mail" aria-label="contact@sehahub.info">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11H3z M3 6.5l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span class="foot-mark">sehahub</span>
      <a href="mailto:contact@sehahub.info">contact@sehahub.info</a>
    </footer>

    <script>
      // 머리 — 홈은 첫 화면을 60% 지나면, 다른 쪽은 조금만 내려도 바탕을 깐다
      const bar = document.querySelector<HTMLElement>("[data-bar]")
      const home = bar?.classList.contains("is-home")
      const onScroll = () => bar?.classList.toggle("is-past", window.scrollY > (home ? window.innerHeight * 0.6 : 8))
      window.addEventListener("scroll", onScroll, { passive: true })
      onScroll()

      // 해/달 — 누르면 바꾸고 기억한다(첫 적용은 머리의 인라인 스크립트)
      const root = document.documentElement
      const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")
      const syncTheme = () => themeBtn?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"))
      themeBtn?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"
        try { localStorage.setItem("theme", root.dataset.theme) } catch {}
        syncTheme()
      })
      syncTheme()

      // 언어 차림 — 바깥을 누르거나 Esc 면 닫는다(여닫기 자체는 details)
      const langMenu = document.querySelector<HTMLDetailsElement>("[data-lang-menu]")
      if (langMenu) {
        document.addEventListener("click", (e) => {
          if (langMenu.open && !langMenu.contains(e.target as Node)) langMenu.open = false
        })
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && langMenu.open) {
            langMenu.open = false
            langMenu.querySelector("summary")?.focus()
          }
        })
      }
    </script>
  </body>
</html>
