---
// 운동해 넵 제품 사이트(/repyep/ · /repyep/en/) 전용 틀 — sehahub 공용 틀(PageLayout · site.css)을 쓰지 않고 앱 자기 색(검정 · 노랑 · 찬 회색)으로.
// 방침 · 지원 쪽(/repyep/privacy/ · /repyep/support/ · /repyep/en/*)은 그대로 공용 틀을 쓴다(이 파일과 무관).
import { getImage } from "astro:assets"
import appIcon from "@assets/repyep/app-icon.png"

type Props = {
  title: string
  description: string
  lang: "ko" | "en"
}

const { title, description, lang } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const koURL = new URL("/repyep/", Astro.site)
const enURL = new URL("/repyep/en/", Astro.site)
const ogIcon = await getImage({ src: appIcon, width: 512, height: 512, format: "png" })
const ogImage = new URL(ogIcon.src, Astro.site)
const fullTitle = `${title} | sehahub`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/png" href={ogIcon.src} />
    <link rel="preload" href="/fonts/WantedSansVariable-KR.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="ko" href={koURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Wanted Sans Variable";
    /* 한글 포함 빌드 · SIL OFL 1.1(public/fonts/WantedSans-OFL.txt) — 앱과 같은 글꼴 */
    src: url("/fonts/WantedSansVariable-KR.woff2") format("woff2");
    font-weight: 400 1000;
    font-style: normal;
    font-display: swap;
  }
  /* 앱 숫자 글꼴 Inter(SIL OFL 1.1 · src/assets/repyep/fonts/Inter-OFL.txt) — 숫자 · 기호만 남긴 조각 */
  @font-face {
    font-family: "RepYep Num";
    src: url("../assets/repyep/fonts/inter-semibold.woff2") format("woff2");
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: "RepYep Num";
    src: url("../assets/repyep/fonts/inter-bold.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: "RepYep Num";
    src: url("../assets/repyep/fonts/inter-extrabold.woff2") format("woff2");
    font-weight: 800;
    font-display: swap;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    color-scheme: light;
    -webkit-text-size-adjust: 100%;
    background: #f0f2f6;
    color: #111;
    font-family: "Wanted Sans Variable", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* 한국어는 낱말 중간에서 줄을 바꾸지 않는다 */
  :lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  body {
    margin: 0;
    min-height: 100svh;
    overflow-x: clip;
  }
  h1,
  h2,
  h3,
  h4,
  p,
  ol {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
