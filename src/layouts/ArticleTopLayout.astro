---
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import { formatDate, readingTime } from "@lib/utils"
import ArrowIcon from "@components/ArrowIcon.astro"
import { slotWidths } from "@lib/layout"
import { isProject } from "@types"

type Props = {
  entry: CollectionEntry<"projects"> | CollectionEntry<"blog">
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary, date } = data

const demos = isProject(entry) ? entry.data.demos ?? [] : []
const storeUrl = isProject(entry) ? entry.data.storeUrl : null
const releasesUrl = isProject(entry) ? entry.data.releasesUrl : null
const repoUrl = isProject(entry) ? entry.data.repoUrl : null
const team = isProject(entry) ? entry.data.team : null
const period = isProject(entry) ? entry.data.period : null
// 스토어 슬롯 = storeUrl 기준(있으면 버튼, 없고 MOBILE 단독이면 준비 중 플레이스홀더).
// 데모 슬롯 = MOBILE 단독이면 억제(단 demos 명시 시 노출). demos 에 스토어 URL 금지 — storeUrl 필드가 규약.
// DEMO 배지는 웹 라이브 데모 전용, 모바일 앱 스토어 링크에는 붙이지 않는다
const badges = isProject(entry) ? entry.data.badges : null
const isMobileOnly = !!badges && badges.includes("MOBILE") && !badges.includes("WEB") && !badges.includes("DEMO")
const images = isProject(entry) ? entry.data.images : null
// 스택 pill — 목록 카드(ProjectCard)와 같은 마크업·클래스. 이력서 링크로 상세에 바로 오는 방문자도 스택을 본다
const tags = isProject(entry) ? entry.data.tags : []

// 스크린샷 스트립의 기하. 🔴 아래 클래스 리터럴과 같은 수여야 한다 — Tailwind JIT 가
// 동적 클래스명을 못 잡으므로 리터럴을 지울 수 없다. 나란히 두는 것이 배선이다
// (Container 의 px-5 ↔ layout.ts 의 CONTAINER_PX 와 같은 처방).
const SHOT_VH = 45 // h-[45svh]
const SHOT_MAX_H = 480 // max-h-[480px]
const SHOT_BORDER = 1 // border

// 실그림 폭 = (요소높이 − 테두리 2) × 종횡비. border-box 라 테두리를 빼야 한다.
// 🔴 엄격 올림(floor+1)이다 — Math.ceil 은 1440/900 = 1.6 처럼 4자리 유한소수인
//    자산에서 아무것도 올리지 않아 선언이 실그림보다 작아질 수 있다(= 흐림).
const shotSizes = (m: ImageMetadata) =>
  `calc((min(${SHOT_VH}svh, ${SHOT_MAX_H}px) - ${SHOT_BORDER * 2}px) * ${(Math.floor((m.width / m.height) * 1e4) + 1) / 1e4})`
---

<div>
  <a href={`/${collection}`} class="group w-fit p-1.5 gap-1.5 text-sm flex items-center border rounded hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
    <ArrowIcon direction="left" />
    <div class="w-full group-hover:text-black group-hover:dark:text-white transition-colors duration-300 ease-in-out">
      목록으로
    </div>
  </a>
  <div class="flex flex-wrap text-sm uppercase mt-12 gap-3 opacity-75">
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current" aria-hidden="true">
        <use href="/ui.svg#calendar"/>
      </svg>
      <span class="sr-only">기간 </span>{period ?? formatDate(date)}
    </div>
    {team && (
      <div class="flex items-center gap-2 border-l border-black/15 dark:border-white/25 pl-3">
        <svg class="size-5 stroke-current" aria-hidden="true">
          <use href="/ui.svg#users"/>
        </svg>
        <span class="sr-only">팀 구성 </span>{team}
      </div>
    )}
    {collection === "blog" && (
      <div class="flex items-center gap-2">
        <svg class="size-5 stroke-current">
          <use href="/ui.svg#book-open"/>
        </svg>
        {readingTime(body)}
      </div>
    )}
  </div>
  <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
    {title}
  </h1>
  <div class="mt-1">
    {summary}
  </div>
  {collection === "projects" && tags.length > 0 &&
    <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="text-xs uppercase opacity-50 shrink-0">스택</span>
      <ul class="flex flex-wrap gap-1">
        {tags.map((t) => (
          <li class="pill pill-muted">{t}</li>
        ))}
      </ul>
    </div>
  }
  {collection === "projects" &&
  <div class="mt-4 flex flex-wrap gap-2">
    {storeUrl ?
      <a href={storeUrl} target="_blank" class="group flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
        <svg class="size-4">
          <use href="/ui.svg#globe" class="fill-current group-hover:fill-black group-hover:dark:fill-white blend"/>
        </svg>
        <span class="text-current group-hover:text-black group-hover:dark:text-white blend">
          App Store
        </span>
      </a>
      : isMobileOnly &&
      <span class="flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/15 dark:border-white/20 opacity-60">
        App Store 출시 준비 중
      </span>
    }
    {(!isMobileOnly || demos.length > 0) && (demos.length > 0 ?
      demos.map((demo) => (
        <a href={demo.url} target="_blank" class="group flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
          <svg class="size-4">
            <use href="/ui.svg#globe" class="fill-current group-hover:fill-black group-hover:dark:fill-white blend"/>
          </svg>
          <span class="text-current group-hover:text-black group-hover:dark:text-white blend">
            {demo.label}
          </span>
        </a>
      ))
      :
      <span class="flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/15 dark:border-white/20 opacity-60">
        라이브 데모 준비 중
      </span>
    )}
    {releasesUrl &&
      <a href={releasesUrl} class="group flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
        <svg class="size-4 stroke-current group-hover:stroke-black group-hover:dark:stroke-white blend">
          <use href="/ui.svg#book-open"/>
        </svg>
        <span class="text-current group-hover:text-black group-hover:dark:text-white blend">
          업데이트 내역
        </span>
      </a>
    }
    {repoUrl &&
      <a href={repoUrl} target="_blank" class="group flex gap-2 items-center px-3 py-1.5 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
        <svg class="size-4">
          <use href="/ui.svg#link" class="fill-current group-hover:fill-black group-hover:dark:fill-white blend"/>
        </svg>
        <span class="text-current group-hover:text-black group-hover:dark:text-white blend">
          저장소
        </span>
      </a>
    }
  </div>
  }
  {images && images.length > 0 &&
    <div tabindex="0" role="region" aria-label="스크린샷" class="mt-6 flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2">
      {images.map((img) => (
        <figure class="shrink-0 snap-start">
          {/* widths 는 목록 카드와 같은 사다리다 — 같은 폭을 요청하면 Astro 가 같은 파일을
              내주므로(DEFAULT_HASH_PROPS 에 sizes 없음) 목록을 거쳐 온 방문자에게 캐시 히트한다.
              sizes 만 여기서 따로 만든다: 상세는 높이 기반이라 형태가 아예 다르다.
              🔴 아래 class 의 `h-[45svh] max-h-[480px] border` ← 프론트매터의
                 SHOT_VH / SHOT_MAX_H / SHOT_BORDER 와 같은 수여야 한다(한쪽만 고치면
                 sizes 가 조용히 거짓이 된다). */}
          <Image
            src={img.src}
            alt={img.caption}
            widths={slotWidths(images[0].src, img.src)}
            sizes={shotSizes(img.src)}
            class="h-[45svh] max-h-[480px] w-auto rounded border border-black/15 dark:border-white/20"
          />
          <figcaption class="mt-2 text-sm text-center opacity-75">{img.caption}</figcaption>
        </figure>
      ))}
    </div>
  }
</div>
