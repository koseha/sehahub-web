---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { Content } from "./_privacy.md"
---

<PageLayout title="내돈아님 개인정보처리방침" description="내돈아님 앱의 개인정보처리방침입니다.">
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading text-3xl">내돈아님 개인정보처리방침</h1>
      <p class="mt-3 text-sm opacity-75">시행일: 2026년 11월 6일 (공고 2026년 10월 7일 · 그 전까지는 2026년 10월 28일까지 <a href="/notmine/privacy-v4-4/" class="underline">v4.4</a>, 2026년 10월 29일부터 <a href="/notmine/privacy-v4-5/" class="underline">v4.5</a> 적용)</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
