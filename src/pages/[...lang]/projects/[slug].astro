---
// 프로젝트 상세(2026-11-20 새 틀) — 머리(돌아가기 · 제목 · 기간 · 팀 · 한 줄 · 링크 · 스택) → 스크린샷 줄 → 본문 → 다음 프로젝트.
// 본문(핵심 도전 · 결정 · 구조 도식)은 예전에 정한 글이라 내용은 그대로 두고 겉모습만 바꿨다.
// 제품은 여기 없다 — 각 팀 제품 사이트(/notmine/ · /repyep/) · 옛 /projects/notmine/ 은 /notmine/ 으로 넘긴다(astro.config).
// 한국어 = /projects/{slug}/ · 영어 · 일본어 = /en/ · /ja/ 아래(2026-11-26 · 번역이 있는 프로젝트만 · src/lib/content.ts)
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import PageLayout from "@layouts/PageLayout.astro"
import { getSortedEntries, isPublished, localizeProjects, type ProjectView } from "@lib/content"
import { LANGS, alternatesOf, langParam, localePath, ui, type Lang } from "@i18n"

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(isPublished)
  const byLang = await Promise.all(LANGS.map(async (lang) => ({ lang, views: await localizeProjects(lang, projects) })))
  return byLang.flatMap(({ lang, views }) =>
    views.map((view) => ({
      params: { lang: langParam(lang), slug: view.slug },
      // langs = 이 프로젝트가 있는 언어들(언어 버튼 · hreflang)
      props: { lang, view, langs: byLang.filter((b) => b.views.some((v) => v.slug === view.slug)).map((b) => b.lang) },
    }))
  )
}

type Props = { lang: Lang; view: ProjectView; langs: Lang[] }
const { lang, view, langs } = Astro.props
const { title, summary, period, team, demos, images } = view
const { tags, storeUrl, releasesUrl, repoUrl } = view.entry.data
const { Content } = await view.body.render()
const t = ui[lang]

const back = { href: localePath(lang, "/projects/"), label: "Projects" }

// 다음 프로젝트 — 같은 언어 쪽 안에서
const ring = await localizeProjects(lang, await getSortedEntries("projects"))
const at = ring.findIndex((p) => p.slug === view.slug)
const next = ring.length > 1 ? ring[(at + 1) % ring.length] : null

// 스크린샷 줄 — 높이를 고정하고 폭은 그림 비율대로(가로 · 세로 그림이 섞여도 높이가 같다)
const SHOT_H = 460 // CSS .pd-shot 의 최대 높이와 같은 수
const shotWidths = (m: ImageMetadata) => {
  const r = m.width / m.height
  return [...new Set([Math.round(r * SHOT_H), Math.round(r * SHOT_H * 2)].map((w) => Math.min(w, m.width)))]
}
const shotSizes = (m: ImageMetadata) => `calc(clamp(280px, 52svh, ${SHOT_H}px) * ${(m.width / m.height).toFixed(4)})`
---

<PageLayout title={title} description={summary} lang={lang} alternates={alternatesOf(`/projects/${view.slug}/`, langs)}>
  <section class="pd-head">
    <a href={back.href} class="pd-back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      {back.label}
    </a>
    <h1 class="pd-title">{title}</h1>
    <p class="pd-meta">
      <span>{period}</span>
      {team && <span>{team}</span>}
    </p>
    <p class="pd-summary">{summary}</p>

    {(storeUrl || demos.length > 0 || releasesUrl || repoUrl) && (
      <div class="pd-links">
        {storeUrl && <a href={storeUrl} target="_blank" class="pd-btn is-main">App Store</a>}
        {demos.map((d) => <a href={d.url} target="_blank" class="pd-btn">{d.label}</a>)}
        {releasesUrl && <a href={releasesUrl} class="pd-btn">{t.releases}</a>}
        {repoUrl && <a href={repoUrl} target="_blank" class="pd-btn">{t.repo}</a>}
      </div>
    )}

    {tags.length > 0 && (
      <ul class="pd-tags" aria-label={t.stack}>
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </section>

  {images.length > 0 && (
    <div class="pd-shots" tabindex="0" role="region" aria-label={t.screenshots}>
      {images.map((img, i) => (
        <figure class="pd-fig" data-reveal style={`--d:${i * 90}ms`}>
          <Image src={img.src} alt={img.caption} widths={shotWidths(img.src)} sizes={shotSizes(img.src)} class="pd-shot" loading={i < 3 ? "eager" : "lazy"} />
          <figcaption>{img.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  <section class="pd-body">
    <article>
      <Content />
    </article>
  </section>

  {next && (
    <section class="pd-next">
      <a href={localePath(lang, `/projects/${next.slug}/`)} class="pd-next-card">
        <span class="pd-next-label">Next</span>
        <span class="pd-next-title">{next.title}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </section>
  )}

  <style>
    .pd-head { max-width: 880px; margin: 0 auto; padding: 120px clamp(16px, 4vw, 40px) 0; }
    .pd-back { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 600; color: var(--muted); transition: color .2s; }
    .pd-back svg { width: 18px; height: 18px; transition: transform .25s var(--spring); }
    .pd-back:hover { color: var(--a); }
    .pd-back:hover svg { transform: translateX(-3px); }
    .pd-title { margin-top: 28px; font-weight: 950; font-size: clamp(44px, 7vw, 88px); letter-spacing: -0.045em; line-height: 1; }
    .pd-meta { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 14px; color: var(--muted); }
    .pd-summary { margin-top: 14px; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.6; max-width: 46em; }
    .pd-links { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px; }
    .pd-btn { display: inline-flex; align-items: center; height: 40px; padding: 0 18px; border-radius: 999px; font-size: 14px; font-weight: 700; border: 1.5px solid var(--ink); transition: background .2s, color .2s, border-color .2s, transform .25s var(--spring); }
    .pd-btn:hover { border-color: var(--a); color: var(--a); transform: translateY(-2px); }
    .pd-btn.is-main { background: var(--ink); color: var(--bg); }
    .pd-btn.is-main:hover { background: var(--a); border-color: var(--a); color: #fff; }
    .pd-tags { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 6px; }
    .pd-tags li { font-size: 12px; padding: 3px 9px; border-radius: 6px; background: rgba(22, 24, 29, .05); color: #3c3f46; }
    :global([data-theme="dark"]) .pd-tags li { background: rgba(236, 238, 241, .08); color: #c9ccd3; }

    /* 스크린샷 줄 — 쪽 폭을 넘어 가로로 흐른다 */
    /* 첫 장은 본문 왼쪽 선에 맞춘다 — 넘기기 맞춤(scroll-snap)이 여백을 무시하고 첫 장을 끝에 붙이지 않게 scroll-padding 에도 같은 값 */
    .pd-shots { --edge: max(clamp(16px, 4vw, 40px), calc((100vw - 880px) / 2 + clamp(16px, 4vw, 40px))); margin-top: 48px; display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px var(--edge) 18px; scroll-padding-inline: var(--edge); scrollbar-width: thin; }
    .pd-fig { flex: none; scroll-snap-align: start; }
    .pd-fig :global(.pd-shot) { height: clamp(280px, 52svh, 460px); width: auto; border-radius: 14px; box-shadow: 0 0 0 1px var(--line), 0 18px 36px -26px rgba(22, 24, 29, .45); }
    .pd-fig figcaption { margin-top: 10px; font-size: 13px; color: var(--muted); max-width: 100%; }

    .pd-body { max-width: 880px; margin: 0 auto; padding: 40px clamp(16px, 4vw, 40px) 0; }

    .pd-next { max-width: 880px; margin: 0 auto; padding: 8px clamp(16px, 4vw, 40px) 100px; }
    .pd-next-card { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 4px 16px; padding: 28px 0 0; border-top: 1px solid var(--line); }
    .pd-next-label { grid-column: 1 / -1; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
    .pd-next-title { font-weight: 900; font-size: clamp(32px, 5vw, 56px); letter-spacing: -0.04em; line-height: 1.05; transition: color .2s; }
    .pd-next-card svg { width: clamp(32px, 4vw, 48px); height: clamp(32px, 4vw, 48px); transition: transform .35s var(--spring), color .2s; }
    .pd-next-card:hover .pd-next-title, .pd-next-card:hover svg { color: var(--a); }
    .pd-next-card:hover svg { transform: translateX(8px); }

    [data-reveal] { opacity: 0; transform: translateY(40px); }
    [data-reveal].is-in { opacity: 1; transform: none; transition: transform 1000ms var(--spring) var(--d), opacity .4s ease var(--d); }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] { opacity: 1; transform: none; }
      .pd-btn, .pd-back svg, .pd-next-card svg { transition: none; }
    }
  </style>

  <script>
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]")
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target) }
    }, { threshold: 0.15, root: null })
    els.forEach((el) => io.observe(el))
  </script>
</PageLayout>
