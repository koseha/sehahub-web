---
// seha — 만든 사람의 이력(2026-11-20 대표 「전자」 = 이력서 · 프로필 링크로 찾아오는 사람용).
// 메뉴에 두지 않는다 · 옛 /work/ 는 여기로 넘긴다(astro.config redirects) · 새 문구를 넣지 않는다(그룹 지식 §2).
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"

// 대표 스택 큐레이션 — 2026-11-20 옛 홈에서 여기로 옮겼다(홈의 주인공이 sehahub 제품으로 바뀜).
// 프로젝트 tags·work stack의 파생이 아니다. 선발과 표시는 다른 축을 쓴다.
// ① 자격 = 사이트 안 근거(프로젝트 tags · 이 쪽의 경력 stack) 또는 사이트에 링크된 라이브 작업물의 실제 배포·운영
// ② 선발 = 기술 축별 대표. 축 상한 = 언어3·백엔드2·데이터3·프론트2·모바일1·인프라4 = 15개(≈115자).
//    정렬은 근거 강도순이고 강도가 비슷하면 검색 노출(ATS) 값이 큰 쪽을 남긴다.
//    같은 계열이 겹치면 하나만 남기고 방향은 계열마다 판단한다 —
//    선례: Cloudflare Pages/Workers→Cloudflare · Riverpod→Flutter · JPA/Hibernate→Spring Boot · Java→Kotlin
//    제외: Node.js(① 미충족) · NCP(근거 최약 = API 호출 1건) · Google Cloud(자격은 서지만 방문자 확인 경로 0)
// ③ 표시 = 근거 출처로 두 줄. 방문자 확인 경로가 있으면 「작업물」, 경력 stack 자기 신고뿐이면 「현업」.
//    확인 경로 = 프로젝트 tags에 실려 그 상세 쪽에서 대조되는 것. ②의 축 상한은 두 줄 합산으로 센다.
//    ⚠️ 이 분류는 현업 줄이 전부 확인 불가 근거임을 드러낸다. 가리지 않는 것이 채택 이유이므로 되돌리지 말 것.
//    현업 줄이 작업물 줄보다 길어지면 항목을 늘려 맞추지 말고 작업물 쪽 근거를 만든다.
//    Docker·Google Cloud는 trackareer tags 인프라 보강 시 확인 경로가 생긴다 — 그때 ③ 재판정.
// 이 주석이 규칙 정본이다. secretary 계획 파일에는 결정 이력만 둔다.
const stack = [
  // 현업 — 경력 stack 단독 근거(익명 처리된 자기 신고). 축: 언어1·백엔드1·데이터1·인프라2
  { label: "현업", items: ["Kotlin", "Spring Boot", "MariaDB", "Docker", "AWS"] },
  // 작업물 — 프로젝트 tags 근거. 축: 언어2·백엔드1·데이터2·프론트2·모바일1·인프라2
  { label: "작업물", items: ["TypeScript", "Python", "NestJS", "PostgreSQL", "Supabase", "React", "Refine", "Flutter", "GitHub Actions", "Cloudflare"] },
]

const collection = await getCollection("work")
collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())
const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return input
  const year = input.getFullYear()
  const month = String(input.getMonth() + 1).padStart(2, "0")
  return `${year}.${month}`
}
---

<PageLayout title="seha" description="seha">
  <TopLayout>
    <h1 class="page-heading text-3xl">seha</h1>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      <li><a href="https://github.com/koseha" target="_blank" class="underline underline-offset-2 hover:text-[var(--a)]">GitHub · koseha</a></li>
      <li><a href="mailto:contact@sehahub.info" class="underline underline-offset-2 hover:text-[var(--a)]">contact@sehahub.info</a></li>
    </ul>
  </TopLayout>
  <BottomLayout>
    <section class="mb-14">
      <p class="font-semibold">주로 다루는 기술</p>
      <div class="mt-4 space-y-3">
        {stack.map((group) => (
          <div>
            <p class="text-sm text-black/60 dark:text-white/60 mb-2">{group.label}</p>
            <ul class="flex flex-wrap items-center gap-2" aria-label={group.label}>
              {group.items.map((tech) => (
                <li class="px-3 py-1.5 rounded border border-black/15 dark:border-white/15 text-sm text-black/75 dark:text-white/75">{tech}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <ul>
      {work.map((entry) => (
        <li class="border-t border-black/10 dark:border-white/10 py-8">
          <div class="text-sm uppercase mb-4">
            {formatWorkDate(entry.data.dateStart)} ~ {formatWorkDate(entry.data.dateEnd)}
          </div>
          <div class="font-semibold">{entry.data.company}</div>
          <div class="text-sm font-semibold">{entry.data.role}</div>
          <article>
            <entry.Content />
          </article>
          {entry.data.stack && entry.data.stack.length > 0 && (
            <ul class="flex flex-wrap gap-1 -mt-8">
              {entry.data.stack.map((s: string) => (
                <li class="pill pill-muted">{s}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </BottomLayout>
</PageLayout>
