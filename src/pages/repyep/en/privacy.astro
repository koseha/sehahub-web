---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_privacy.md"
---

<PageLayout title="RepYep Privacy Policy" description="Privacy policy for the RepYep iPhone app. No account and no server — your records stay on your iPhone." lang="en">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="en" />
      <h1 class="page-heading text-3xl">RepYep Privacy Policy</h1>
      <p class="mt-3 text-sm opacity-75">Effective November 20, 2026 (first version) · <a href="/repyep/privacy/" class="underline" lang="ko">한국어</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
