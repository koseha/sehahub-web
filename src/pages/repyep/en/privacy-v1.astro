---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_privacy-v1.md"
---

<PageLayout title="RepYep Privacy Policy (first version · earlier version)" description="An earlier version (first version) of the RepYep privacy policy." lang="en">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="en" />
      <h1 class="page-heading text-3xl">RepYep Privacy Policy (first version)</h1>
      <p class="mt-3 text-sm opacity-75">Earlier version · in effect November 20 – November 22, 2026 · <a href="/repyep/en/privacy/" class="underline">View current policy</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
