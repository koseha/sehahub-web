---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { Content } from "./_support.md"
---

<PageLayout title="RepYep Support" description="Frequently asked questions and contact information for the RepYep app." lang="en">
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading text-3xl">RepYep Support</h1>
      <p class="mt-3 text-sm opacity-75">FAQ and contact · <a href="/repyep/support/" class="underline" lang="ko">한국어</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
