---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_privacy-v2.md"
---

<PageLayout title="RepYep Privacy Policy (version 2, no longer in effect)" description="Version 2 of the RepYep privacy policy. A newer version is now in effect." lang="en">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="en" />
      <h1 class="page-heading text-3xl">RepYep Privacy Policy (version 2)</h1>
      <p class="mt-3 text-sm opacity-75">This earlier version was in effect from November 23 to November 24, 2026. <a href="/repyep/en/privacy/" class="underline">View the current policy</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
