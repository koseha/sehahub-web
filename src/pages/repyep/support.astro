---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_support.md"
---

<PageLayout title="운동해 넵 지원" description="운동해 넵 앱의 자주 묻는 질문과 문의 안내입니다.">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="ko" />
      <h1 class="page-heading text-3xl">운동해 넵 지원</h1>
      <p class="mt-3 text-sm opacity-75">자주 묻는 질문과 문의 안내 · <a href="/repyep/en/support/" class="underline" lang="en">English</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
