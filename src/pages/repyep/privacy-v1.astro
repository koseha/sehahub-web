---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_privacy-v1.md"
---

<PageLayout title="운동해 넵 개인정보 처리방침 (첫 판 · 이전 판)" description="운동해 넵 앱 개인정보 처리방침의 이전 판(첫 판)입니다.">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="ko" />
      <h1 class="page-heading text-3xl">운동해 넵 개인정보 처리방침 (첫 판)</h1>
      <p class="mt-3 text-sm opacity-75">이전 판 · 적용 기간 2026년 11월 20일 ~ 2026년 11월 22일 · <a href="/repyep/privacy/" class="underline">현행 방침 보기</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
