---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import SiteLink from "@components/repyep/SiteLink.astro"
import { Content } from "./_privacy.md"
---

<PageLayout title="운동해 넵 개인정보 처리방침" description="운동해 넵 앱의 개인정보 처리방침입니다. 계정과 서버가 없고 기록은 이 폰 안에만 있어요.">
  <TopLayout>
    <div class="animate">
      <SiteLink lang="ko" />
      <h1 class="page-heading text-3xl">운동해 넵 개인정보 처리방침</h1>
      <p class="mt-3 text-sm opacity-75">시행일: 2026년 11월 23일 (2판) · 이전 판 <a href="/repyep/privacy-v1/" class="underline">첫 판</a> · <a href="/repyep/en/privacy/" class="underline" lang="en">English</a></p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article>
        <Content />
      </article>
    </div>
  </BottomLayout>
</PageLayout>
