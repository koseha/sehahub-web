---
import { getSortedEntries, pinnedFirst } from "@lib/content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

const posts = (await getSortedEntries("blog")).slice(0, 3)

const projects = pinnedFirst(await getSortedEntries("projects")).slice(0, 3)

// 홈 대표 스택 큐레이션 — 프로젝트 tags·work stack의 파생이 아니다. 선발과 표시는 다른 축을 쓴다.
// ① 자격 = 사이트 안 근거(프로젝트 tags · /work stack) 또는 사이트에 링크된 라이브 작업물의 실제 배포·운영
// ② 선발 = 기술 축별 대표. 축 상한 = 언어3·백엔드2·데이터3·프론트2·모바일1·인프라4 = 15개(≈115자).
//    정렬은 근거 강도순이고 강도가 비슷하면 검색 노출(ATS) 값이 큰 쪽을 남긴다.
//    같은 계열이 겹치면 하나만 남기고 방향은 계열마다 판단한다 —
//    선례: Cloudflare Pages/Workers→Cloudflare · Riverpod→Flutter · JPA/Hibernate→Spring Boot · Java→Kotlin
//    제외: Node.js(① 미충족) · NCP(근거 최약 = API 호출 1건) · Google Cloud(자격은 서지만 방문자 확인 경로 0)
// ③ 표시 = 근거 출처로 두 줄. 방문자 확인 경로가 있으면 「작업물」, /work stack 자기 신고뿐이면 「현업」.
//    확인 경로 = 프로젝트 tags에 실려 아래 카드에서 대조되는 것. ②의 축 상한은 두 줄 합산으로 센다.
//    ⚠️ 이 분류는 현업 줄이 전부 확인 불가 근거임을 드러낸다. 가리지 않는 것이 채택 이유이므로 되돌리지 말 것.
//    현업 줄이 작업물 줄보다 길어지면 항목을 늘려 맞추지 말고 작업물 쪽 근거를 만든다.
//    Docker·Google Cloud는 trackareer tags 인프라 보강 시 확인 경로가 생긴다 — 그때 ③ 재판정.
// 이 주석이 규칙 정본이다. secretary 계획 파일에는 결정 이력만 둔다.
const stack = [
  // 현업 — /work stack 단독 근거(익명 처리된 자기 신고). 축: 언어1·백엔드1·데이터1·인프라2
  { label: "현업", items: ["Kotlin", "Spring Boot", "MariaDB", "Docker", "AWS"] },
  // 작업물 — 프로젝트 tags 근거. 축: 언어2·백엔드1·데이터2·프론트2·모바일1·인프라2
  { label: "작업물", items: ["TypeScript", "Python", "NestJS", "PostgreSQL", "Supabase", "React", "Refine", "Flutter", "GitHub Actions", "Cloudflare"] },
]
---

<PageLayout title="새하(seha) 포트폴리오" description={SITE.DESCRIPTION}>

  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-black hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Meteors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>

  <!-- HERO -->
  <section class="relative h-screen w-full">
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px] bg-gradient-to-b from-black/25 dark:from-white/75 from-0% to-transparent to-5%'>
        <div id="planet" class='w-full h-full bg-white dark:bg-black rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-20 rounded-full bg-neutral-900/25 dark:bg-white/25 blur-3xl'/>
        </div>
      </div>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
            안녕하세요
          </p>
          <p class='animated text-2xl md:text-3xl lg:text-4xl font-bold text-black dark:text-white tracking-tight'>
            새하(seha)입니다.
          </p>
          <p class='animated text-sm md:text-base lg:text-lg mt-4 opacity-75'>
            행동이 가진 힘을 믿기에, 가슴 뛰는 일이라면 가장 먼저 발을 내딛습니다.
          </p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/projects/' class='py-2 px-4 rounded truncate text-xs md:text-sm lg:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend'>
              작업물 보기
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-sm p-5 space-y-24 pb-16">

      <!-- About Section -->
      <section class="animate">
        <article>
          <p>2026년부터 현업에서 활동하고 있는 개발자 새하입니다.</p>
          <p>제품의 명확함은 불필요한 욕심을 덜어내는 것에서 시작된다고 믿습니다. 그렇기에 기획은 방향성을 분명히 하는 데 집중하고, 프론트엔드와 소통하는 API는 군더더기 없이 깔끔하게 설계합니다.</p>
          <p>운영의 효율을 높이는 관리자 페이지 역시 기획부터 직접 구축하며 구현 과정에서는 AI 에이전트를 적극적으로 활용해 1인 개발로서의 속도와 완성도를 모두 챙깁니다. 저의 작업물은 라이브 데모와 App Store에 출시한 앱으로 직접 확인할 수 있습니다.</p>
        </article>
      </section>

      <!-- Blog Preview Section -->
      {posts.length > 0 && (
        <section class="animate">
          <div class="space-y-4">
            <div class="flex justify-between">
              <p class="font-semibold text-black dark:text-white">
                Recent posts
              </p>
              <a href="/blog/" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
                <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                  All posts
                </span>
              </a>
            </div>
            <ul class="space-y-4">
              {posts.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Tech Stack Section -->
      <section class="animate">
        <div class="space-y-4">
          <p class="font-semibold text-black dark:text-white">
            주로 다루는 기술
          </p>
          <div class="space-y-3">
            {stack.map((group) => (
              <div>
                <p class="text-sm text-black/60 dark:text-white/60 mb-2">{group.label}</p>
                <ul class="flex flex-wrap items-center gap-2" aria-label={group.label}>
                  {group.items.map((tech) => (
                    <li class="px-3 py-1.5 rounded border border-black/15 dark:border-white/20 text-sm text-black/75 dark:text-white/75">
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Project Preview Section -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between">
            <p class="font-semibold text-black dark:text-white">
              작업물
            </p>
            <a href="/projects/" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                전체 보기
              </span>
            </a>
          </div>
          <ul class="space-y-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="animate">
        <div class="space-y-4">
          <p class="font-semibold text-black dark:text-white">
            연락처
          </p>
          <div class="space-y-2">
            {SOCIALS.map((social) => (
              <div class="flex items-center gap-4">
                <span class="text-sm opacity-50 w-16">{social.NAME}</span>
                <a href={social.HREF} target="_blank" class="group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend">
                  <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">
                    {social.TEXT}
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

    </div>
  </div>
</PageLayout>
