---
// 홈 시안(2026-11-20 · 대표 「그래」) — sehahub = 만드는 곳의 입구. 기준 레퍼런스 = notboring.software 의 결(만들어 내놓는 앱이 손에 잡히는 물건처럼 움직인다).
// 🔴 문구를 넣지 않는다(대표 11/20 「메인에 텍스트 그냥 지워라」) — 이름 · 앱 아이콘 · 연락처만.
// 옛 디자인(PageLayout · 행성 · 별)은 쓰지 않는다. 다른 쪽은 아직 옛 틀 그대로다(시안 범위 = 홈).
import { Image } from "astro:assets"
import notmineIcon from "../assets/products/notmine-icon.png"

const WORD = "sehahub".split("")

// 제품이 늘면 여기에 더한다 — 하나일 때는 크게 가운데, 여럿이면 줄을 이룬다
const products = [
  { name: "내돈아님", icon: notmineIcon, href: "/projects/notmine/" },
]

const SLABS = 16 // 아이콘 두께를 이루는 겹 수(두께 자체는 CSS --depth)
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>sehahub</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex" />
</head>
<body>
  <header class="bar" data-bar>
    <a href="/" class="bar-mark" aria-label="sehahub">sehahub</a>
    <a href="mailto:contact@sehahub.info" class="bar-mail" aria-label="contact@sehahub.info">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18v11H3z M3 6.5l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </a>
  </header>

  <main>
    <!-- 첫 화면 — 글자가 떨어져 튕기며 자리를 잡고, 포인터가 다가가면 들썩인다 -->
    <section class="hero">
      <h1 class="word" aria-label="sehahub">
        {WORD.map((ch, i) => (
          <span class="ch-drop" style={`--i:${i}; --r:${[-18, 12, -8, 16, -14, 9, -11][i]}deg;`} aria-hidden="true">
            <span class="ch" data-ch>{ch}</span>
          </span>
        ))}
      </h1>
      <div class="hint" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </section>

    <!-- 제품 — 아이콘을 두께 있는 물건으로. 화면에 들어오면 떨어져 놓이고, 포인터 쪽으로 기울고, 가만두면 둥실거린다 -->
    <section class="shelf" aria-label="Products">
      <p class="label">Products</p>
      <ul class={`objs ${products.length === 1 ? "is-solo" : ""}`}>
        {products.map((p, i) => (
          <li>
            <a href={p.href} class="obj" data-obj style={`--d:${i * 120}ms`}>
              <span class="obj-drop">
                <span class="obj-float" data-float>
                  <span class="obj-tilt" data-tilt>
                    {Array.from({ length: SLABS }).map((_, k) => (
                      <span class="slab" style={`--k:${k + 1}`} aria-hidden="true"></span>
                    ))}
                    <Image src={p.icon} alt="" widths={[320, 640]} sizes="(min-width: 768px) 320px, 220px" class="face" loading="lazy" />
                    <span class="gloss" aria-hidden="true"></span>
                  </span>
                </span>
                <span class="floor" data-floor aria-hidden="true"></span>
              </span>
              <span class="obj-name">{p.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="foot">
    <span class="foot-mark">sehahub</span>
    <a href="mailto:contact@sehahub.info">contact@sehahub.info</a>
  </footer>

  <style is:global>
    @font-face {
      font-family: "Wanted Sans Variable";
      src: url("/fonts/WantedSansVariable-KR.woff2") format("woff2");
      font-weight: 400 1000;
      font-display: swap;
    }
    :root {
      /* 베이지 배경은 쓰지 않는다(대표 11/20 「요즘 ai 구현물들이 다 배경색을 베이지로」) — 흰 바탕 · 먹색 글자 */
      --bg: #ffffff;
      --ink: #16181d;
      --muted: #6b6f78;
      /* 포인트 = 한 색 「주황색 + 미세한 분홍색」(대표 11/20 · 분홍기 도는 주황 = 코랄 계열) — 옆면 · 두께 · 표시에만.
         입체 명암은 다른 색을 섞지 않고 같은 색을 어둡게만 한다 */
      --a: #ff6b4a;
      /* 튕김 — CSS linear() 로 만든 스프링(라이브러리 없음) */
      --spring: linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; }
    body { font-family: "Wanted Sans Variable", system-ui, sans-serif; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }

    /* 머리 — 첫 화면을 지나면 작은 이름이 나타난다 */
    .bar { position: fixed; inset: 0 0 auto 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; padding: 18px clamp(16px, 4vw, 40px); transition: background .3s; }
    .bar.is-past { background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .bar-mark { font-weight: 900; letter-spacing: -0.03em; font-size: 18px; opacity: 0; transform: translateY(-6px); transition: opacity .3s, transform .3s; }
    .bar.is-past .bar-mark { opacity: 1; transform: none; }
    .bar-mail { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 999px; transition: background .2s; }
    .bar-mail:hover { background: color-mix(in srgb, var(--a) 14%, transparent); color: var(--a); }
    .bar-mail svg { width: 22px; height: 22px; }

    /* 첫 화면 */
    .hero { min-height: 100svh; display: grid; place-items: center; position: relative; }
    .word { display: flex; font-weight: 950; font-size: clamp(76px, 22vw, 260px); letter-spacing: -0.045em; line-height: 1; user-select: none; }
    .ch-drop { display: inline-block; animation: drop 1300ms var(--spring) both; animation-delay: calc(300ms + var(--i) * 75ms); }
    .ch {
      display: inline-block; will-change: transform;
      /* 옆면 — 글자를 눌러 뽑은 덩어리처럼. em 이라 글자 크기에 비례한다(휴대폰에서 번지지 않게) */
      /* 옆면 = 포인트 한 색 · 뒤로 갈수록 같은 색이 조금씩 어두워진다 */
      text-shadow:
        .004em .004em 0 var(--a),
        .008em .008em 0 color-mix(in oklab, var(--a), #000 2%),
        .012em .012em 0 color-mix(in oklab, var(--a), #000 4%),
        .016em .016em 0 color-mix(in oklab, var(--a), #000 6%),
        .02em .02em 0 color-mix(in oklab, var(--a), #000 8%),
        .024em .024em 0 color-mix(in oklab, var(--a), #000 10%),
        .028em .028em 0 color-mix(in oklab, var(--a), #000 12%),
        .032em .032em 0 color-mix(in oklab, var(--a), #000 14%),
        .055em .085em .11em color-mix(in srgb, var(--a) 22%, transparent);
    }
    @keyframes drop {
      from { transform: translateY(-115vh) rotate(var(--r)); }
      to { transform: none; }
    }
    .hint { position: absolute; bottom: 28px; left: 50%; width: 28px; height: 28px; translate: -50% 0; color: var(--a); animation: bob 1.8s ease-in-out 2s infinite both; opacity: 0; }
    .hint svg { width: 100%; height: 100%; }
    @keyframes bob { 0% { opacity: 0; transform: translateY(-4px); } 30% { opacity: 1; } 50% { transform: translateY(6px); } 100% { opacity: .9; transform: translateY(-4px); } }

    /* 제품 선반 */
    .shelf { min-height: 100svh; padding: 12vh clamp(16px, 4vw, 40px) 16vh; display: flex; flex-direction: column; align-items: center; }
    .label { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--a); margin-bottom: 9vh; }
    .objs { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(48px, 8vw, 120px); }
    .obj { --size: 200px; --depth: calc(var(--size) * .075); display: flex; flex-direction: column; align-items: center; gap: calc(44px + var(--depth)); cursor: pointer; outline: none; }
    .is-solo .obj { --size: clamp(220px, 30vw, 320px); }
    .obj-drop { position: relative; display: block; width: var(--size); height: var(--size); opacity: 0; transform: translateY(-60vh) rotate(-14deg); }
    .obj.is-in .obj-drop { opacity: 1; transform: none; transition: transform 1400ms var(--spring) var(--d), opacity 200ms linear var(--d); }
    .obj-float { position: absolute; inset: 0; display: block; perspective: 900px; will-change: transform; }
    .obj-tilt { position: absolute; inset: 0; display: block; transform-style: preserve-3d; will-change: transform; transition: scale .25s var(--spring); }
    .obj:active .obj-tilt { scale: .94; transition-duration: .08s; }
    .slab, .face, .gloss { position: absolute; inset: 0; border-radius: 22.4%; }
    /* 두께 = sehahub 바탕 — 포인트 한 색으로 확실하게(대표 11/20 「얇아서 눈만 아프고. 주려면 확실하게」).
       글자 옆면과 같은 방향(오른쪽 아래)으로 늘 보이게 겹을 민다 · 뒤로 갈수록 같은 색을 조금씩 어둡게 */
    .slab { transform: translate3d(calc(var(--k) * var(--depth) / 16), calc(var(--k) * var(--depth) / 16), calc(var(--k) * -0.4px)); background: color-mix(in oklab, var(--a), #000 calc(var(--k) * 0.9%)); }
    .face { width: 100%; height: 100%; object-fit: cover; transform: translateZ(0.5px); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06); }
    .gloss { transform: translateZ(1px); background: linear-gradient(135deg, rgba(255, 255, 255, .55) 0%, rgba(255, 255, 255, 0) 38%, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, .06) 100%); pointer-events: none; }
    .floor { position: absolute; left: calc(12% + var(--depth)); right: calc(12% - var(--depth)); bottom: calc(-26px - var(--depth)); height: 18px; border-radius: 50%; background: radial-gradient(closest-side, rgba(22, 24, 29, .22), transparent); will-change: transform, opacity; }
    .obj-name { font-size: 15px; font-weight: 700; letter-spacing: -0.01em; opacity: 0; transform: translateY(8px); }
    .obj.is-in .obj-name { opacity: 1; transform: none; transition: opacity .5s ease calc(var(--d) + 700ms), transform .5s ease calc(var(--d) + 700ms); }
    .obj:focus-visible .obj-name { text-decoration: underline; text-underline-offset: 4px; }

    .foot { display: flex; justify-content: space-between; align-items: center; padding: 28px clamp(16px, 4vw, 40px); font-size: 14px; color: var(--muted); border-top: 1px solid rgba(27, 31, 39, .1); }
    .foot-mark { font-weight: 900; letter-spacing: -0.03em; color: var(--ink); }
    .foot a:hover { color: var(--a); }
    .obj:hover .obj-name { color: var(--a); }

    /* 움직임 줄이기 — 떨어지기 · 둥실 · 기울기를 모두 끈다 */
    @media (prefers-reduced-motion: reduce) {
      .ch-drop, .hint { animation: none; opacity: 1; }
      .obj-drop, .obj-name { opacity: 1; transform: none; }
      .obj.is-in .obj-drop, .obj.is-in .obj-name { transition: none; }
    }
  </style>

  <script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const finePointer = window.matchMedia("(pointer: fine)").matches

    // 머리 — 첫 화면을 지나면 이름을 보인다
    const bar = document.querySelector<HTMLElement>("[data-bar]")
    const onScroll = () => bar?.classList.toggle("is-past", window.scrollY > window.innerHeight * 0.6)
    window.addEventListener("scroll", onScroll, { passive: true })
    onScroll()

    // 제품 — 화면에 들어오면 떨어뜨린다
    const objs = [...document.querySelectorAll<HTMLElement>("[data-obj]")]
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target) }
    }, { threshold: 0.35 })
    objs.forEach((o) => io.observe(o))

    if (!reduce) {
      let px = -1e4, py = -1e4, active = false
      window.addEventListener("pointermove", (e) => { px = e.clientX; py = e.clientY; active = true }, { passive: true })
      document.addEventListener("pointerleave", () => { active = false })

      const letters = [...document.querySelectorAll<HTMLElement>("[data-ch]")].map((el) => ({ el, y: 0, r: 0 }))
      const items = objs.map((o) => ({
        o,
        float: o.querySelector<HTMLElement>("[data-float]")!,
        tilt: o.querySelector<HTMLElement>("[data-tilt]")!,
        floor: o.querySelector<HTMLElement>("[data-floor]")!,
        rx: 0, ry: 0, hover: 0,
      }))
      items.forEach((it) => {
        it.o.addEventListener("pointerenter", () => { it.hover = 1 })
        it.o.addEventListener("pointerleave", () => { it.hover = 0 })
      })

      const lerp = (a: number, b: number, t: number) => a + (b - a) * t
      let lift = 0

      const frame = (t: number) => {
        // 글자 — 포인터 가까이 있는 글자만 들썩
        for (const L of letters) {
          const b = L.el.getBoundingClientRect()
          const cx = b.left + b.width / 2, cy = b.top + b.height / 2
          const d = Math.hypot(px - cx, py - cy)
          const k = active && finePointer ? Math.max(0, 1 - d / 260) : 0
          L.y = lerp(L.y, -k * 26, 0.14)
          L.r = lerp(L.r, k * (px < cx ? 6 : -6), 0.14)
          L.el.style.transform = `translateY(${L.y.toFixed(2)}px) rotate(${L.r.toFixed(2)}deg)`
        }

        // 아이콘 — 포인터 쪽으로 기울고 · 가만두면 천천히 흔들리고 · 늘 둥실
        for (const it of items) {
          const b = it.float.getBoundingClientRect()
          if (b.bottom < -200 || b.top > window.innerHeight + 200) continue
          const cx = b.left + b.width / 2, cy = b.top + b.height / 2
          let tx: number, ty: number
          if (active && finePointer) {
            tx = Math.max(-1, Math.min(1, (px - cx) / (window.innerWidth * 0.45)))
            ty = Math.max(-1, Math.min(1, (py - cy) / (window.innerHeight * 0.45)))
          } else {
            // 터치 기기 — 스크롤 위치로 돌린다
            const s = (cy - window.innerHeight / 2) / window.innerHeight
            tx = Math.sin(t / 2300) * 0.45 + s * 0.6
            ty = Math.sin(t / 1900) * 0.35 - s * 0.4
          }
          // 옆면이 오른쪽 아래에 고정이라 기울기는 작게 — 크게 돌리면 반대쪽에서 납작함이 드러난다
          it.rx = lerp(it.rx, -ty * 11, 0.08)
          it.ry = lerp(it.ry, tx * 13, 0.08)
          lift = lerp(lift, it.hover * 18, 0.12)
          const bob = Math.sin(t / 1100) * 9 - lift
          it.float.style.transform = `translateY(${bob.toFixed(2)}px)`
          it.tilt.style.transform = `rotateX(${it.rx.toFixed(2)}deg) rotateY(${it.ry.toFixed(2)}deg)`
          // 높이 뜰수록 그림자는 작고 옅게
          const h = (9 - bob) / 36
          it.floor.style.transform = `scale(${(1.05 - h * 0.35).toFixed(3)})`
          it.floor.style.opacity = (1 - h * 0.55).toFixed(3)
        }
        requestAnimationFrame(frame)
      }
      requestAnimationFrame(frame)
    }
  </script>
</body>
</html>
